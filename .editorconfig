###############################################################################
# Use the same .editorconfig as for bureau repos
###############################################################################

# Stop here; do not inherit settings from a parent repository.
root = true

[*]
charset = utf-8
# `bureau doctor` warns about CRLF and missing final newlines.
end_of_line = lf
insert_final_newline = true
# Four spaces match the nested task examples in the README and templates.
indent_style = space
indent_size = 4

[*.md]
# Markdown hard line breaks use two trailing spaces; do not strip them.
trim_trailing_whitespace = false

# Makefile recipes need tabs; editors would otherwise rewrite them to spaces.
[Makefile]
indent_style = tab
indent_size = tab
