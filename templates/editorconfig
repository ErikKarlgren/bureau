###############################################################################
# Most editors need an EditorConfig extension or plugin; Neovim has it built in
###############################################################################

# Stop here; do not inherit settings from a parent repository.
root = true

[*]
charset = utf-8
# `bureau doctor` warns about CRLF and missing final newlines.
end_of_line = lf
insert_final_newline = true
# Four spaces match the nested task examples in the README and templates.
indent_style = space
indent_size = 4

[*.md]
# Markdown hard line breaks use two trailing spaces; do not strip them.
trim_trailing_whitespace = false
